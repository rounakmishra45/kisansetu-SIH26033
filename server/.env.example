# ==============================================================================
# KisanSetu B2B Backend - Environment Configuration Template
# SIH 2026 Problem Statement 26033: Farmer-to-Consumer Agri-Marketplace
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# PostgreSQL + PostGIS Connection Layer
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# If unavailable locally, backend automatically activates an in-memory mock dataset
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kisansetu_db
DB_POOL_MAX=20
DB_TIMEOUT_MS=5000

# Twilio WhatsApp Webhook Integration
# Webhook URL to register in Twilio Console: https://<your-domain>/api/whatsapp/webhook
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Bhashini National Language Translation Mission (ULCA APIs)
# Official Portal: https://bhashini.gov.in / https://meity-auth.ulca.gov.in
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_ULCA_API_KEY=your_bhashini_ulca_api_key
BHASHINI_PIPELINE_ID=64392f96daac500b55c543d6

# Python FastAPI AI Microservice Proxy
# Handles advanced LLM intent extraction and mandi price anomaly detection
FASTAPI_AI_URL=http://localhost:8000
FASTAPI_TIMEOUT_MS=6000
